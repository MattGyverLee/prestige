{
  "name": "prestige",
  "version": "0.3.0",
  "description": "consider yourself described",
  "homepage": "./",
  "main": "public/electron.js",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest",
    "preview": "vite preview",
    "dist": "electron-builder",
    "dist-d": "set DEBUG=electron-builder && electron-builder",
    "web-dev": "env-cmd -f .env.web vite --config vite.config.web.ts",
    "web-prod": "env-cmd -f .env.web vite build --config vite.config.web.ts",
    "electron-dev-mac": "concurrently \"BROWSER=none npm run start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-dev": "env-cmd -f .env.electron concurrently \"vite\" \"wait-on http://localhost:3000 && electron public/electron-dev.js\"",
    "electron-debug": "env-cmd -f .env.electron vite",
    "electron-prod": "env-cmd -f .env.electron concurrently \"vite\" \"wait-on http://localhost:3000 && electron public/electron.js\"",
    "postinstall": "electron-builder install-app-deps",
    "electron-pack": "env-cmd -f .env.electron vite build",
    "eslint-check": "eslint --print-config . | eslint-config-prettier-check",
    "format": "prettier --write \"src/**/*.js\"",
    "prelint": "eslint src --ext .tsx --ext .js",
    "precommit": "lint-staged",
    "lint": "eslint src --ext .tsx --ext .js",
    "lint-fix": "eslint src --fix --ext .tsx --ext .js",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 3 safari version"
    ]
  },
  "dependencies": {
    "@cypress/electron-plugin": "^1.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@reduxjs/toolkit": "^2.10.1",
    "@types/redux": "^3.6.0",
    "@types/xml2js": "^0.4.8",
    "chokidar": "^3.6.0",
    "electron-is-dev": "^3.0.1",
    "env-cmd": "^10.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "ffmpeg": "^0.0.4",
    "ffprobe": "^1.1.2",
    "file-url": "^4.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "mime": "^4.0.4",
    "notistack": "^0.8.9",
    "path": "^0.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-player": "^2.16.0",
    "react-redux": "^9.2.0",
    "react-sizeme": "^3.0.2",
    "react-test-renderer": "^18.3.1",
    "react-xml-parser": "^1.1.8",
    "redux": "^4.0.5",
    "redux-thunk": "^2.3.0",
    "rimraf": "^6.0.1",
    "sass": "^1.80.7",
    "screenfull": "^6.0.2",
    "wavesurfer.js": "^4.5.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/helper-builder-react-jsx": "^7.12.13",
    "@babel/helper-call-delegate": "^7.12.13",
    "@babel/helper-define-map": "^7.12.13",
    "@babel/helper-regex": "^7.10.5",
    "@devexpress/dx-core": "^4.0.11",
    "@devexpress/dx-grid-core": "^4.0.11",
    "@devexpress/dx-react-core": "^4.0.11",
    "@devexpress/dx-react-grid": "^4.0.11",
    "@devexpress/dx-react-grid-material-ui": "^4.0.11",
    "@fortawesome/fontawesome-svg-core": "^1.2.19",
    "@fortawesome/free-solid-svg-icons": "^5.9.0",
    "@fortawesome/react-fontawesome": "^0.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/auth0-js": "^9.10.2",
    "@types/classnames": "^2.2.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-redux": "^7.1.0",
    "@types/react-router-dom": "^4.3.4",
    "@types/react-select": "^2.0.19",
    "@types/wavesurfer.js": "^2.0.2",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.7.0",
    "browserslist": "^4.24.3",
    "concurrently": "^9.1.0",
    "cypress": "^13.16.1",
    "electron": "^38.5.0",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^3.2.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "ffmpeg-static-electron": "^2.0.1",
    "ffprobe-static-electron": "^2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.2.0",
    "vitest": "^4.0.7",
    "wait-on": "^8.0.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": "react-app",
    "env": {
      "browser": true,
      "node": true
    }
  },
  "author": {
    "name": "Matthew Lee",
    "email": "langtech_cameroon@sil.org",
    "url": "https://LangTechCameroon.info"
  },
  "build": {
    "appId": "info.LangTechCameroon.prestige",
    "productName": "Prestige",
    "copyright": "Copyright © 2019 ${author}",
    "extraFiles": [
      {
        "from": "bin/${os}/${arch}",
        "to": "resources/bin/${os}/${arch}",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/silence.wav",
        "to": "public/silence.wav",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/assets/icons/icon.ico",
        "to": "build/icon.ico",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.utilities"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
