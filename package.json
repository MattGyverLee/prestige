{
  "name": "prestige",
  "version": "0.3.0",
  "description": "consider yourself described",
  "homepage": "./",
  "main": "public/electron.js",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "generate:fixtures": "node scripts/generate-test-media.js",
    "preview": "vite preview",
    "dist": "electron-builder",
    "dist-d": "set DEBUG=electron-builder && electron-builder",
    "web-dev": "env-cmd -f .env.web vite --config vite.config.web.ts",
    "web-prod": "env-cmd -f .env.web vite build --config vite.config.web.ts",
    "electron-dev-mac": "concurrently \"BROWSER=none npm run start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-dev": "env-cmd -f .env.electron concurrently \"vite --port 5175\" \"wait-on http://localhost:5175 && electron public/electron-dev.js\"",
    "electron-dev:ps": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "electron-debug": "env-cmd -f .env.electron vite",
    "electron-prod": "env-cmd -f .env.electron concurrently \"vite\" \"wait-on http://localhost:3000 && electron public/electron.js\"",
    "postinstall": "electron-builder install-app-deps",
    "electron-pack": "env-cmd -f .env.electron vite build",
    "eslint-check": "eslint --print-config . | eslint-config-prettier-check",
    "format": "prettier --write \"src/**/*.js\"",
    "prelint": "eslint src --ext .tsx --ext .js",
    "precommit": "lint-staged",
    "lint": "eslint src --ext .tsx --ext .js",
    "lint-fix": "eslint src --fix --ext .tsx --ext .js",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 3 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@reduxjs/toolkit": "^2.10.1",
    "@types/xml2js": "^0.4.8",
    "chokidar": "^3.6.0",
    "electron-is-dev": "^2",
    "env-cmd": "^10.1.0",
    "ffmpeg": "^0.0.4",
    "ffprobe": "^1.1.2",
    "file-url": "^4.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "mime": "^4.0.0",
    "path": "^0.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-player": "^2.16.0",
    "react-redux": "^7.1.0",
    "react-resize-detector": "^12.3.0",
    "react-test-renderer": "^16.8.6",
    "react-xml-parser": "^1.1.8",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "rimraf": "^5.0.0",
    "sass": "^1.94.0",
    "wavesurfer.js": "^7",
    "xml2js": "^0.6.2",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@babel/helper-builder-react-jsx": "^7.12.13",
    "@babel/helper-call-delegate": "^7.12.13",
    "@babel/helper-define-map": "^7.12.13",
    "@babel/helper-regex": "^7.10.5",
    "@devexpress/dx-core": "^4.0.11",
    "@devexpress/dx-grid-core": "^4.0.11",
    "@devexpress/dx-react-core": "^4.0.11",
    "@devexpress/dx-react-grid": "^4.0.11",
    "@devexpress/dx-react-grid-material-ui": "^4.0.11",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@fortawesome/fontawesome-svg-core": "^6.5.0",
    "@fortawesome/free-solid-svg-icons": "^6.5.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/auth0-js": "^9.10.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-redux": "^7.1.0",
    "@types/react-router-dom": "^4.3.4",
    "@types/react-select": "^2.0.19",
    "@types/wavesurfer.js": "^2.0.2",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.0.7",
    "browserslist": "^4.23.0",
    "concurrently": "^9.1.0",
    "cypress": "^13.16.0",
    "depcheck": "^1.4.7",
    "electron": "^38.5.0",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-jest": "^28",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react": "^7.37.5",
    "ffmpeg-static-electron": "^2.0.1",
    "ffprobe-static-electron": "^2.0.0",
    "husky": "^9.1.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.0",
    "vitest": "^4.0.7",
    "wait-on": "^8.0.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "author": {
    "name": "Matthew Lee",
    "email": "langtech_cameroon@sil.org",
    "url": "https://LangTechCameroon.info"
  },
  "build": {
    "appId": "info.LangTechCameroon.prestige",
    "productName": "Prestige",
    "copyright": "Copyright © 2019 ${author}",
    "extraFiles": [
      {
        "from": "bin/${os}/${arch}",
        "to": "resources/bin/${os}/${arch}",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/silence.wav",
        "to": "public/silence.wav",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/assets/icons/icon.ico",
        "to": "build/icon.ico",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.utilities"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
